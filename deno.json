{
  "tasks": {
    "start": "deno run --allow-net --allow-env --allow-read main.ts",
    "dev": "deno run --watch --allow-net --allow-env --allow-read main.ts",
    "check": "deno check main.ts src/**/*.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "test": "deno test",
    "build": "echo 'No build step — Deno native'",
    "build-site": "deno run --allow-read --allow-write src/site/render.ts",
    "migrate-kv": "deno run --allow-read --allow-write --allow-env src/kv/migration.ts",
    "bench-hot-path": "deno run --allow-read --allow-env src/bench/hot_path.ts"
  },
  "unstable": [
    "kv"
  ],
  "imports": {
    "dns-packet": "npm:dns-packet@^5.6.1",
    "@std/assert": "jsr:@std/assert@^1.0.10",
    "marked": "npm:marked@^18.0.0"
  },
  "lint": {
    "exclude": [
      ".kilo/",
      "_site/"
    ]
  },
  "fmt": {
    "exclude": [
      ".kilo/",
      "_site/"
    ]
  }
}
